# Generated host exports (`ctx traits export`). Regenerated from the canonical
# trait on demand and re-derivable from it, so the tree is a build artifact,
# not source — and publish stages it from the package, not from here.
.agents/

# Downloaded by @ctx-traits/cli during postinstall; release archives remain
# the canonical binary artifacts.
packages/cli/binary/

# Rendered host exports. `ctx traits export` writes these on request;
# nothing in the repository needs them, and committing them means every
# guidance change drags a regenerated artifact along with it (0226).
.agents/skills/
