{
  "name": "@ctx-traits/config",
  "version": "0.1.0-alpha.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctx-company/traits.git",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.ts' 'test/**/*.ts'",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
