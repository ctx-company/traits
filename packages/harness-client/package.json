{
  "name": "@ctx-traits/harness-client",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctx-company/traits.git",
    "directory": "packages/harness-client"
  },
  "publishConfig": {
    "access": "restricted",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "dprint": "0.55.2",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2"
  }
}
