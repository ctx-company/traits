{
  "excludes": ["dist", "node_modules", "src/generated.ts"],
  "includes": ["src/**/*.ts", "test/**/*.ts"],
  "plugins": ["https://plugins.dprint.dev/typescript-0.95.13.wasm"],
  "typescript": {
    "lineWidth": 120,
    "quoteStyle": "alwaysDouble",
    "semiColons": "always",
    "useTabs": false
  }
}
